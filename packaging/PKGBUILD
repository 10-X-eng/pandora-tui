pkgname=pandora-tui
pkgver=0.1.0
pkgrel=3
pkgdesc='Pandora terminal player with background playback and desktop media controls'
arch=('any')
license=('MIT')
depends=('python' 'python-textual' 'python-dbus-next' 'python-secretstorage' 'python-pycryptodome' 'mpv' 'cava')
makedepends=('python-build' 'python-installer' 'python-setuptools')
optdepends=('xdg-terminal-exec: launch from desktop menus' 'gnome-keyring: securely remember login')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('f5d08c3b94581776d8c3469e29ca71d1a07f195994811334d82af8e875a57bca')
build() {
  cd "$srcdir/$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}
package() {
  cd "$srcdir/$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 packaging/pandora-tui.desktop "$pkgdir/usr/share/applications/pandora-tui.desktop"
}
